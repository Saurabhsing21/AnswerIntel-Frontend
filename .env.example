# --- API ---
# the backend API URL the server-side proxy calls (empty = http://localhost:8000)
BACKEND_URL=
# same value as the backend's PROXY_SHARED_SECRET; sends each visitor's address so rate limits are per person
PROXY_SHARED_SECRET=

# --- Site URLs ---
# the app, e.g. https://app.seenlense.com
NEXT_PUBLIC_APP_URL=
# the marketing site, e.g. https://seenlense.com
NEXT_PUBLIC_SITE_URL=
# the marketing site, server side
SITE_URL=

# --- Features ---
NEXT_PUBLIC_WAITLIST_ONLY="false"
NEXT_PUBLIC_FREE_CHECK="false"
# same as backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Error monitoring (Sentry) ---
# empty = off
NEXT_PUBLIC_SENTRY_DSN=

# --- Waitlist email (Resend) ---
RESEND_API_KEY=
# Resend audience for waitlist sign-ups
RESEND_AUDIENCE_ID=
EMAIL_FROM=

# --- Payments (Paddle) ---
# sandbox | production. Required: the app refuses to load Paddle without it, so it never runs against the wrong account.
NEXT_PUBLIC_PADDLE_ENV=
# client-side token from Paddle > Developer tools > Authentication (test_... in sandbox, live_... in production)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
